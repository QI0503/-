/* 做菜记录页样式 */

.page-record {
  padding: 20rpx 30rpx;
}

/* 统计信息 */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 添加按钮 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  background: #fff;
  border: 2rpx dashed #FF6B9D;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.add-btn text {
  font-size: 30rpx;
  color: #FF6B9D;
}

/* 记录列表 */
.records-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.section-header {
  margin-bottom: 25rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 时间线 */
.timeline {
  position: relative;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 30rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8C42);
  border-radius: 50%;
}

.timeline-line {
  position: absolute;
  left: 7rpx;
  top: 40rpx;
  bottom: 0;
  width: 2rpx;
  background: #FFE0E8;
}

.timeline-card {
  background: #FFF5F8;
  border-radius: 15rpx;
  padding: 20rpx;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.cook-date {
  font-size: 24rpx;
  color: #999;
}

.cook-photo {
  width: 100%;
  height: 300rpx;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}

.cook-note {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20rpx 0;
}

.load-more text {
  font-size: 26rpx;
  color: #FF6B9D;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 250rpx;
  height: 250rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
  border-radius: 50rpx;
}

.empty-btn text {
  color: #fff;
  font-size: 28rpx;
}

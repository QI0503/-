/* 冰箱推荐页样式 */

.page-fridge {
  padding-bottom: 30rpx;
}

/* 标题区域 */
.header-section {
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 食材选择区 */
.ingredients-section {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  padding: 8rpx 20rpx;
  background: #FFF5F8;
  border-radius: 20rpx;
}

.clear-btn text {
  font-size: 24rpx;
  color: #FF6B9D;
}

/* 分类Tab */
.category-tabs {
  display: flex;
  overflow-x: auto;
  padding-bottom: 15rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  padding: 12rpx 25rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  margin-right: 15rpx;
  white-space: nowrap;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
}

.tab-item text {
  font-size: 26rpx;
  color: #666;
}

.tab-item.active text {
  color: #fff;
}

/* 食材网格 */
.ingredients-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.ingredient-item {
  padding: 12rpx 25rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  border: 2rpx solid transparent;
}

.ingredient-item.selected {
  background: #FFF0F5;
  border-color: #FF6B9D;
}

.ingredient-item text {
  font-size: 26rpx;
  color: #666;
}

.ingredient-item.selected text {
  color: #FF6B9D;
}

/* 已选食材 */
.selected-section {
  padding-top: 20rpx;
  border-top: 1rpx solid #FFF5F8;
}

.selected-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.selected-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
  border-radius: 30rpx;
}

.selected-tag text {
  font-size: 24rpx;
  color: #fff;
  margin-right: 10rpx;
}

.remove-btn {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 推荐按钮 */
.recommend-btn-wrap {
  padding: 20rpx 30rpx;
}

.recommend-btn {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B9D, #FF8C42);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 25rpx rgba(255, 107, 157, 0.3);
}

.recommend-btn.disabled {
  opacity: 0.5;
}

.recommend-btn text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}

/* 推荐结果 */
.result-section {
  margin: 20rpx 30rpx;
}

.result-count {
  font-size: 24rpx;
  color: #999;
}

.recipe-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.recipe-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.recipe-cover {
  width: 100%;
  height: 200rpx;
}

.recipe-info {
  padding: 15rpx 20rpx;
}

.recipe-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.recipe-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.match-info {
  padding-top: 10rpx;
  border-top: 1rpx solid #FFF5F8;
}

.match-text {
  font-size: 22rpx;
  color: #FF6B9D;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-state image {
  width: 250rpx;
  height: 250rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 10rpx;
}

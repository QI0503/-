/* 全局样式 - ZQQ&LWW的云厨房 */

/* 色彩变量 */
page {
  --color-primary: #FF6B9D;
  --color-primary-light: #FF8FB5;
  --color-primary-dark: #E84855;
  --color-secondary: #FF8C42;
  --color-success: #4CAF50;
  --color-warning: #FF9800;
  --color-danger: #F44336;
  --color-bg: #FFF5F8;
  --color-bg-white: #FFFFFF;
  --color-text: #4A4A4A;
  --color-text-light: #999999;
  --color-text-white: #FFFFFF;
  --color-border: #FFE0E8;
  
  background-color: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用类 */
.container {
  padding: 20rpx 30rpx;
}

.card {
  background: var(--color-bg-white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: var(--color-text-white);
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.text-primary {
  color: var(--color-primary);
}

.text-secondary {
  color: var(--color-secondary);
}

.text-light {
  color: var(--color-text-light);
}

.text-center {
  text-align: center;
}

/* 标签样式 */
.tag {
  display: inline-block;
  background: var(--color-bg);
  color: var(--color-primary);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 20rpx 0;
}

/* flex布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 图片样式 */
.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-contain {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 省略号 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  color: var(--color-text-light);
  font-size: 28rpx;
}

/* 购物清单页样式 */

.page-shopping {
  padding: 20rpx 30rpx;
}

/* 当前清单 */
.current-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.complete-btn {
  padding: 10rpx 25rpx;
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  border-radius: 30rpx;
}

.complete-btn text {
  font-size: 24rpx;
  color: #fff;
}

/* 清单项 */
.items-list {
  display: flex;
  flex-direction: column;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #FFF5F8;
}

.item-card:last-child {
  border-bottom: none;
}

.item-card.checked {
  opacity: 0.6;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.check-box image {
  width: 100%;
  height: 100%;
}

.item-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.item-card.checked .item-name {
  text-decoration: line-through;
  color: #999;
}

.item-amount {
  font-size: 28rpx;
  color: #FF6B9D;
}

/* 进度条 */
.progress-bar {
  margin-top: 25rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #FFF5F8;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
  text-align: center;
}

.progress-track {
  height: 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #FF6B9D, #FF8C42);
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* 历史清单 */
.history-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #FFF5F8;
}

.history-card:last-child {
  border-bottom: none;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.history-name {
  font-size: 30rpx;
  color: #333;
}

.history-date {
  font-size: 24rpx;
  color: #999;
}

.history-items {
  padding: 15rpx 0;
}

.history-item {
  padding: 8rpx 0;
}

.history-item text {
  font-size: 26rpx;
  color: #666;
}

.checked-text {
  text-decoration: line-through;
  color: #999 !important;
}

.expand-btn {
  text-align: center;
  padding: 10rpx 0;
}

.expand-btn text {
  font-size: 24rpx;
  color: #FF6B9D;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-state text {
  color: #999;
  font-size: 26rpx;
}

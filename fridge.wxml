<!-- 冰箱推荐页 - ZQQ&LWW的云厨房 -->
<view class="page-fridge">
  <!-- 标题区域 -->
  <view class="header-section">
    <text class="page-title">冰箱有什么做什么</text>
    <text class="page-desc">选择你冰箱里现有的食材，我来推荐能做的菜</text>
  </view>

  <!-- 食材选择区 -->
  <view class="ingredients-section">
    <view class="section-header">
      <text class="section-title">选择食材</text>
      <view class="clear-btn" bindtap="clearAll" wx:if="{{selectedIngredients.length > 0}}">
        <text>清空</text>
      </view>
    </view>

    <!-- 常用食材分类 -->
    <view class="category-tabs">
      <view class="tab-item {{activeCategory === item.name ? 'active' : ''}}" wx:for="{{ingredientCategories}}" wx:key="name" bindtap="switchCategory" data-name="{{item.name}}">
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- 食材列表 -->
    <view class="ingredients-grid">
      <view class="ingredient-item {{item.selected ? 'selected' : ''}}" wx:for="{{currentIngredients}}" wx:key="name" bindtap="toggleIngredient" data-name="{{item.name}}">
        <text>{{item.name}}</text>
      </view>
    </view>

    <!-- 已选食材 -->
    <view class="selected-section" wx:if="{{selectedIngredients.length > 0}}">
      <text class="selected-title">已选食材：</text>
      <view class="selected-tags">
        <view class="selected-tag" wx:for="{{selectedIngredients}}" wx:key="*this">
          <text>{{item}}</text>
          <view class="remove-btn" bindtap="removeIngredient" data-name="{{item}}">×</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 推荐按钮 -->
  <view class="recommend-btn-wrap">
    <view class="recommend-btn {{selectedIngredients.length === 0 ? 'disabled' : ''}}" bindtap="getRecommendations">
      <text>推荐菜谱</text>
    </view>
  </view>

  <!-- 推荐结果 -->
  <view class="result-section" wx:if="{{recommendList.length > 0}}">
    <view class="section-header">
      <text class="section-title">为你推荐</text>
      <text class="result-count">共{{recommendList.length}}道菜</text>
    </view>
    <view class="recipe-list">
      <view class="recipe-card" wx:for="{{recommendList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
        <image class="recipe-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view class="recipe-info">
          <text class="recipe-name ellipsis">{{item.name}}</text>
          <view class="recipe-meta">
            <text class="meta-time">{{item.duration}}分钟</text>
            <text class="meta-difficulty">{{item.difficultyText}}</text>
          </view>
          <view class="match-info">
            <text class="match-text">匹配食材：{{item.matchCount}}种</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{recommendList.length === 0 && searched}}">
    <image src="/images/empty/empty_search.png" mode="aspectFit"></image>
    <text>没有找到匹配的菜谱</text>
    <text class="empty-tip">试试选择其他食材组合</text>
  </view>
</view>

/* 搜索页样式 */

.page-search {
  min-height: 100vh;
  background: #FFF5F8;
}

/* 搜索头部 */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50rpx;
  padding: 16rpx 25rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ddd;
  border-radius: 50%;
  font-size: 28rpx;
  color: #666;
}

.cancel-btn {
  margin-left: 20rpx;
}

.cancel-btn text {
  color: #fff;
  font-size: 28rpx;
}

/* 搜索历史 */
.history-section,
.hot-section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.clear-history {
  font-size: 26rpx;
  color: #999;
}

.history-tags,
.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.history-tag,
.hot-tag {
  padding: 12rpx 25rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 157, 0.08);
}

.hot-tag {
  background: linear-gradient(135deg, #FFF5F8, #FFE8F0);
  color: #FF6B9D;
}

/* 搜索结果 */
.result-section {
  padding: 20rpx 30rpx;
}

.result-header {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recipe-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.recipe-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.recipe-desc {
  font-size: 26rpx;
  color: #999;
  flex: 1;
}

.recipe-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.recipe-meta .tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  margin: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-state image {
  width: 250rpx;
  height: 250rpx;
  margin-bottom: 30rpx;
}

.empty-state text {
  color: #999;
  font-size: 28rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #bbb;
  margin-top: 10rpx;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 50rpx 0;
  color: #999;
  font-size: 28rpx;
}

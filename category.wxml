<!-- 分类页 - ZQQ&LWW的云厨房 -->
<view class="page-category">
  <!-- 分类Tab -->
  <view class="category-tabs">
    <view class="tab-item {{activeTab === 'cuisine' ? 'active' : ''}}" bindtap="switchTab" data-tab="cuisine">
      <text>菜系</text>
    </view>
    <view class="tab-item {{activeTab === 'method' ? 'active' : ''}}" bindtap="switchTab" data-tab="method">
      <text>做法</text>
    </view>
    <view class="tab-item {{activeTab === 'scene' ? 'active' : ''}}" bindtap="switchTab" data-tab="scene">
      <text>场景</text>
    </view>
  </view>

  <!-- 分类内容 -->
  <view class="category-content">
    <!-- 分类图标网格 -->
    <view class="category-grid" wx:if="{{!selectedCategory}}">
      <view class="category-item" wx:for="{{currentCategories}}" wx:key="name" bindtap="selectCategory" data-name="{{item.name}}">
        <view class="category-icon-wrap">
          <image class="category-icon" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>

    <!-- 选中分类后的菜谱列表 -->
    <view class="recipe-list" wx:if="{{selectedCategory}}">
      <view class="list-header">
        <view class="back-btn" bindtap="clearCategory">
          <image class="back-icon" src="/images/icons/icon_back.png" mode="aspectFit"></image>
          <text>返回</text>
        </view>
        <text class="list-title">{{selectedCategory}}</text>
        <view class="list-count">
          <text>共{{recipeCount}}道菜</text>
        </view>
      </view>

      <view class="recipe-grid">
        <view class="recipe-card" wx:for="{{recipeList}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
          <image class="recipe-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="recipe-info">
            <text class="recipe-name ellipsis">{{item.name}}</text>
            <view class="recipe-meta">
              <text class="meta-time">{{item.duration}}分钟</text>
              <text class="meta-difficulty">{{item.difficultyText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{recipeList.length === 0 && !loading}}">
        <image src="/images/empty/empty_search.png" mode="aspectFit"></image>
        <text>暂无相关菜谱</text>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{hasMore}}">
        <text>加载中...</text>
      </view>
    </view>
  </view>
</view>

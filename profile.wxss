/* 我的页面样式 */

.page-profile {
  min-height: 100vh;
  background: #FFF5F8;
}

/* 用户头像区域 */
.user-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
  border-radius: 0 0 40rpx 40rpx;
}

.user-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  margin-bottom: 20rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  margin: -30rpx 30rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 157, 0.15);
  position: relative;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B9D;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #FFE0E8;
}

/* 功能菜单 */
.menu-section {
  margin: 20rpx 30rpx;
}

.menu-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 15rpx;
  padding-left: 10rpx;
}

.menu-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #FFF5F8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  border-radius: 15rpx;
}

.record-icon {
  background: #FFF0F5;
}

.nutrition-icon {
  background: #FFF8E1;
}

.shopping-icon {
  background: #E8F5E9;
}

.fridge-icon {
  background: #E3F2FD;
}

.dislike-icon {
  background: #FFEBEE;
}

.cache-icon {
  background: #F3E5F5;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-value {
  margin-right: 15rpx;
}

.menu-value text {
  font-size: 26rpx;
  color: #999;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* 关于 */
.about-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 0;
}

.about-text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

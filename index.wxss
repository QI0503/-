/* 首页样式 */

.page-index {
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB5);
}

.search-inner {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 15rpx;
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

/* 通用section */
.section {
  margin: 20rpx 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-left: 15rpx;
}

.section-more {
  font-size: 26rpx;
  color: #FF6B9D;
}

/* 每日推荐 */
.recommend-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 157, 0.2);
}

.recommend-cover {
  width: 100%;
  height: 400rpx;
}

.recommend-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.recommend-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}

.recommend-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 15rpx;
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
}

.recommend-tags .tag {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  margin-right: 15rpx;
  margin-bottom: 0;
}

/* 快捷入口 */
.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 25rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(255, 107, 157, 0.1);
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.entry-text {
  font-size: 24rpx;
  color: #666;
}

/* 最近收藏 */
.favorites-scroll {
  white-space: nowrap;
}

.favorite-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
}

.favorite-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 15rpx;
}

.favorite-name {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  text-align: center;
}

/* 猜你喜欢 */
.recipe-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.recipe-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
}

.recipe-cover {
  width: 100%;
  height: 250rpx;
}

.recipe-info {
  padding: 20rpx;
}

.recipe-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.recipe-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.recipe-tags {
  display: flex;
  flex-wrap: wrap;
}

.recipe-tags .tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

/* 刷新按钮 */
.refresh-btn {
  padding: 10rpx 25rpx;
  background: #FFF5F8;
  border-radius: 30rpx;
}

.refresh-btn text {
  font-size: 26rpx;
  color: #FF6B9D;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}
